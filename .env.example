# Copy this file to .env. Never commit .env or include it in shared archives.
GUARDIAN_LLM_MODE=deepseek
GUARDIAN_LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Total model-request budget in seconds; errors fall back to local read-only queries.
GUARDIAN_LLM_TIMEOUT=45
# APK 启动引导码（12-100 字符）。留空时启动自动生成随机码并打印到本地终端。
# 该码仅作引导；日常请用 `python -m guardian.pairing` 生成一次性随机码。
GUARDIAN_APK_PAIRING_CODE=
# 配对码有效期（分钟，1-60）与 Bearer 凭证有效期（天，1-365）。
GUARDIAN_APK_PAIRING_TTL_MINUTES=10
GUARDIAN_APK_CREDENTIAL_DAYS=30
# v0.5 自主调查与告警闭环
GUARDIAN_INVESTIGATION_MAX_TOOL_CALLS=8
GUARDIAN_INVESTIGATION_DEADLINE_SECONDS=20
GUARDIAN_NOTIFICATION_TTL_SECONDS=60
GUARDIAN_NOTIFICATION_COOLDOWN_SECONDS=300
# 可选的本地控制台人工确认令牌；留空表示只依赖 127.0.0.1 本地访问。
# GUARDIAN_CONSOLE_TOKEN=
